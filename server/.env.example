# Azure Entra ID — App Registration
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-app-client-id
AZURE_CLIENT_SECRET=your-app-client-secret

# Azure AI Search — Schema RAG Index
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your-search-admin-key
AZURE_SEARCH_INDEX_NAME=fabric-schema

# Azure OpenAI — Embedding Model
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com
AZURE_OPENAI_API_KEY=your-openai-key
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Power BI / Fabric
# For production: leave empty and use OBO flow (user token passed through)
# For PoC: set a valid Power BI access token (expires hourly — use refresh_token.sh)
POWERBI_ACCESS_TOKEN=

# Server
PORT=8080
